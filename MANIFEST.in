include LICENSE
include README.md
include CHANGELOG.md
include SECURITY.md
include CONTRIBUTING.md
include CODE_OF_CONDUCT.md
include DEPLOYMENT.md
include LEADERBOARD_PROTOCOL.md
include pyproject.toml

graft analysis
graft benchmarks
graft detectors
graft gap_analysis
graft governance
graft probes

prune tests
prune *.egg-info

exclude detectors/CLASSIFIER_FINDINGS.md
exclude probes/COMBO_FINDINGS.md
exclude probes/CRESCENDO_FINDINGS.md
exclude probes/E2E_FINDINGS.md
recursive-exclude probes *_report.json

global-exclude *.py[cod]
